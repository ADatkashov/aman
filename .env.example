# Copy to `.env` (never commit the real file). Used by docker-compose and the backend.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=aman
POSTGRES_USER=aman
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend (Spring Boot) --------------------------------------------------
AMAN_DB_URL=jdbc:postgresql://localhost:5432/aman
AMAN_DB_USER=aman
AMAN_DB_PASSWORD=change-me-strong-password
# REQUIRED. >= 32 random bytes: `openssl rand -base64 48`
AMAN_JWT_SECRET=
# Directory for uploaded medical documents (use an encrypted volume in production).
AMAN_STORAGE_DIR=./data/documents
# Comma-separated browser origins allowed by CORS (leave empty for mobile-only).
AMAN_CORS_ORIGINS=
# Spring profile: leave empty in production; `demo` seeds synthetic data and
# returns OTP codes in API responses (NEVER use in production).
SPRING_PROFILES_ACTIVE=

# --- Flutter (passed with --dart-define, see README) -------------------------
# AMAN_API_MODE=demo|remote      (default: demo, no backend needed)
# AMAN_API_URL=https://api.example.kz/api/v1
# AMAN_MAPS_PROVIDER=2gis|google (route deep links; no API key needed)
