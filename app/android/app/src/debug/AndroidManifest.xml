<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development (hot reload, debugger). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds may talk to a local backend over http://10.0.2.2:8080.
         Release builds keep Android's default: cleartext traffic is blocked, HTTPS only. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
